{
  "name": "finance-portal-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check build-only",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "preview": "vite preview",
    "lint": "run-s lint:es lint:style",
    "lint:es": "eslint . --max-warnings 0",
    "lint:style": "stylelint \"src/**/*.{vue,scss}\"",
    "format": "prettier --write src/",
    "check": "run-s type-check lint"
  },
  "dependencies": {
    "pinia": "^4.0.3",
    "vue": "^3.5.41",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "@vueuse/core": "^14.4.0",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "npm-run-all2": "^9.0.3",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.6",
    "sass-embedded": "^1.104.0",
    "stylelint": "^17.15.0",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.11"
  }
}
